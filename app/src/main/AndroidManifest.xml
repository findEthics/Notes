<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.notes">

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/notes_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/notes_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EInkNotes">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.example.notes.action.NEW_NOTE" />
                <action android:name="com.example.notes.action.NEW_TODO" />
                <action android:name="com.example.notes.action.APPEND_NOTE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>
    </application>

</manifest>
