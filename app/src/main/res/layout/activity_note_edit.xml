<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground">

    <!-- Top bar with time and Done button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="?attr/colorSurface"
        android:padding="8dp">

        <TextView
            android:id="@+id/tvNotesLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@string/app_name"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:gravity="start|center" />

        <!-- Spacer to push items to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnAddCheckBox"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:src="@drawable/ic_check_box"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="Add Checkbox"
            android:padding="8dp" />

        <!-- Done button -->
        <Button
            android:id="@+id/btnDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Done"
            android:textStyle="bold"
            android:textColor="?attr/colorOnPrimary"
            android:backgroundTint="?attr/colorPrimary" />
    </LinearLayout>

    <!-- Bold horizontal divider line -->
    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="?attr/colorOnSurface" />

    <!-- Note content area -->
    <com.example.notes.NoteEditText
        android:id="@+id/etNoteContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="top|start"
        android:padding="16dp"
        android:background="@null"
        android:hint="Title\n\nContent"
        android:inputType="textNoSuggestions|textMultiLine"
        android:textColor="?android:attr/textColorPrimary"
        android:textColorHint="?android:attr/textColorSecondary"
        android:textSize="24sp" />
</LinearLayout>
