<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light Theme -->
    <style name="Theme.EInkNotes.Light" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/light_text_primary</item>
        <item name="colorPrimaryVariant">@color/light_text_primary</item>
        <item name="colorOnPrimary">@color/light_background</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/light_accent</item>
        <item name="colorSecondaryVariant">@color/light_accent</item>
        <item name="colorOnSecondary">@color/light_background</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/light_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Background colors. -->
        <item name="android:windowBackground">@color/light_background</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <!-- Text colors. -->
        <item name="android:textColor">@color/light_text_primary</item>
        <item name="android:textColorPrimary">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
        <!-- No animations for better e-ink experience -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Dark Theme -->
    <style name="Theme.EInkNotes.Dark" parent="Theme.MaterialComponents.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/dark_text_primary</item>
        <item name="colorPrimaryVariant">@color/dark_text_primary</item>
        <item name="colorOnPrimary">@color/dark_background</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/dark_accent</item>
        <item name="colorSecondaryVariant">@color/dark_accent</item>
        <item name="colorOnSecondary">@color/dark_background</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Background colors. -->
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="colorSurface">@color/dark_surface</item>
        <item name="colorOnSurface">@color/dark_text_primary</item>
        <!-- Text colors. -->
        <item name="android:textColor">@color/dark_text_primary</item>
        <item name="android:textColorPrimary">@color/dark_text_primary</item>
        <item name="android:textColorSecondary">@color/dark_text_secondary</item>
        <!-- No animations for better e-ink experience -->
        <item name="android:windowAnimationStyle">@null</item>
    </style>

    <!-- Default theme (Light) -->
    <style name="Theme.EInkNotes" parent="Theme.EInkNotes.Light" />
</resources>
